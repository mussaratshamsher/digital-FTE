NEXT_PUBLIC_API_URL=https://your-app-url.hf.space/api/v1
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
GROQ_API_KEY=your_groq_api_key
MODEL_NAME=llama-3.3-70b-versatile

# Supabase Project Configuration
PROJECT_ID=your_project_id
PROJECT_REGION=your_region
PROJECT_URL=your_supabase_url

# Supabase Auth & API Keys
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend/Public Keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
DATA_API_URL=your_supabase_url/rest/v1/

# Database Configuration
SUPABASE_DATABASE_PASSWORD=your_database_password

# Using Synchronous psycopg2 driver explicitly
DATABASE_URL=postgresql+psycopg2://postgres.your_project_id:your_database_password@your_db_host:5432/postgres
CONNECTION_STRING=postgresql+psycopg2://postgres.your_project_id:your_database_password@your_db_host:5432/postgres

# GMAIL CRENDENTIALS
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
SUPABASE_CALLBACK_URL=your_supabase_url/auth/v1/callback

# JWT settings
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WhatsApp - TWILIO
TWILIO_SAND_BOX_NUMBER=+14155238886
TWILIO_MAIL_SUPPORT=mail-sport
TO_PHONE_NUMBER=your_phone_number
FROM_PHONE_NUMBER=+14155238886
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Environment
ENV=production
LOG_LEVEL=info
